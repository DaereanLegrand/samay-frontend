#!/usr/bin/env bash
# =============================================================================
# pre-commit — git hook wrapper (TOOL-04, agent M-26).
#
# Thin delegation layer: all gate logic lives in tools/pre-commit.sh so there
# is exactly ONE place to maintain. Git invokes hooks with the worktree root
# as cwd, but we resolve the root explicitly (safe under core.hooksPath and
# bare-ish setups) before delegating.
#
# Installed via: make hooks   (sets core.hooksPath=tools/hooks)
# =============================================================================
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
exec bash "$ROOT/tools/pre-commit.sh"
