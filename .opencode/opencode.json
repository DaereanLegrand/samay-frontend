{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/process/DEVELOPMENT-WORKFLOW.md",
    "docs/process/FILE-OWNERSHIP.md",
    ".opencode/DEV-SERVER.md",
    ".opencode/SIMULATORS.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git pull*": "allow",
      "git am*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "pkill*": "deny",
      "kill*": "deny",
      "*flutter attach*": "deny",
      "*>/dev/tty*": "deny",
      "*/dev/ttys*": "deny",
      "*kitten @*": "deny",
      "*osascript*System Events*": "deny",
      "*simctl create*": "deny",
      "*simctl boot*": "deny",
      "*simctl bootstatus*": "deny",
      "*simctl shutdown*": "deny",
      "*simctl erase*": "deny",
      "*simctl delete*": "deny",
      "*simctl clone*": "deny",
      "*simctl upgrade*": "deny",
      "*sudo*": "deny",
      "*do shell script*": "deny",
      "*administrator privileges*": "deny",
      "*Authorization Services*": "deny"
    }
  }
}
