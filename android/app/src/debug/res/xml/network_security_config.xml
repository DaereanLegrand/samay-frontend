<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only policy: permit cleartext so TESTING=true dev workflows work
     against local stacks (10.0.2.2 emulator alias, 127.0.0.1/localhost,
     <local-lan-ip> LAN, <vm-ip-prefix>x VM bridge). Debug builds are never
     distributed. See README (Local backend) and Makefile TESTING targets. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
