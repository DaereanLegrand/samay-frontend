# Samay app — .env.example (template for `make init`, one .env per project)
#
# .env is NOT bundled into the app. The Flutter app reads SUPABASE_URL /
# SUPABASE_ANON_KEY at BUILD time via `--dart-define-from-file=.env`, so nothing
# secret ships in the APK/IPA. Server-side secrets never belong here.
#
# `make init` writes .env for the chosen backend (testing / local / own). The
# values below are the public testing config; no secret is involved.

# Supabase (testing uses the hosted testing stack)
SUPABASE_URL=https://samay-api-testing.qallariy.lat
SUPABASE_ANON_KEY=

# Google Sign-In OAuth client ids (public, no secret; per environment).
# GOOGLE_OAUTH_CLIENT_ID is the Web client used as serverClientId; the iOS
# client id is passed to GIDClientID + GOOGLE_OAUTH_IOS_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=

# RevenueCat public SDK key (public by design; it cannot mint purchases).
# Empty ⇒ the app runs in stub mode (purchase UI disabled, no store calls).
# For debug/testing use the Test Store key; release builds fetch the
# per-platform key with `RC=true`.
REVENUECAT_PUBLIC_SDK_KEY=
REVENUECAT_TEST_STORE_KEY=

# Qallariy vector tiles (Martin behind the token-gated Caddy gateway). Sent as
# the X-Tiles-Token header (anti-hotlink guard, not a secret).
TILES_TOKEN=

# API endpoints (informational; set by `make init`)
API_TESTING_URL=https://samay-api-testing.qallariy.lat
API_PROD_URL=https://samay-api.qallariy.lat
