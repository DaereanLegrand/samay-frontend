# Samay — Environment Variables
#
# ⚠️  .env is NOT bundled into the app (SEC-03/SEC-09/M-31 fixed 2026-08-09).
# The Flutter app reads SUPABASE_URL / SUPABASE_ANON_KEY at BUILD time via
# --dart-define (or `--dart-define-from-file=.env`, see the Makefile's
# FLUTTER_DEFINES), so secrets never ship inside the APK/IPA.
#
#   make dev                        # or: make build
#   # CI/real deploys pass explicit defines (they win over the file):
#   flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL \
#               --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Server-side secrets (SERVICE_ROLE_KEY, ADMIN_USER_ID, …) are consumed only
# by the Go CLI / API server / Edge Functions — NEVER pass them to the app.

# Supabase (placeholders — replace outside the repo at deploy time)
SUPABASE_URL=http://127.0.0.1:54386
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_USER_ID=

# Pusher Beams (Push Notifications)
PUSHER_BEAMS_INSTANCE_ID=
PUSHER_BEAMS_SECRET_KEY=

# RevenueCat
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Public SDK key injected at build time via --dart-define (I-61): an empty
# value runs the app in stub mode — purchase UI disabled, no store calls.
# Safe to ship by design (it cannot mint purchases) but never hardcoded.
REVENUECAT_PUBLIC_SDK_KEY=

# Edge Functions
SYSTEM_ADMIN_USER_ID=
